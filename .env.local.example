# Assetly — environment template
#
# Copy to `.env.local` (gitignored) and fill in real values. `.env.local` must
# never be committed.
#
# STATUS: no Firebase project exists yet. OD-05 (project ID, dev/staging/
# production split, custom domain) is unresolved and Phase 0 exits with it
# explicitly deferred — see planning/DECISIONS.md DEC-014. Until it is resolved,
# leaving these blank is expected: lib/firebase/client.ts and admin.ts detect an
# incomplete environment and stay uninitialised instead of throwing.

# --- Firebase web SDK (browser) ---------------------------------------------
# Safe to expose: these identify the project, they do not authorise access.
# Access control is enforced by firestore.rules and storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (server only) ---------------------------------------
# SECRET. A service-account credential — never prefix these with NEXT_PUBLIC_
# and never reference them from a Client Component.
# FIREBASE_ADMIN_PRIVATE_KEY is the single-line form with literal `\n` escapes,
# exactly as the Firebase console exports it.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=
